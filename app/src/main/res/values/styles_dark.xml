<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Elegant Dark Theme -->
    <style name="AppTheme.Dark" parent="AppTheme.Base">
        <!-- Window attributes -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Primary colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorPrimaryDark">@color/dark_primary_dark</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_secondary_variant</item>
        <item name="colorOnSecondary">@color/dark_text_primary</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="android:colorBackgroundFloating">@color/dark_dialog_background</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorTertiary">@color/dark_text_tertiary</item>
        <item name="android:textColorHint">@color/dark_text_tertiary</item>
        
        <!-- Control colors -->
        <item name="colorControlNormal">@color/dark_icon_secondary</item>
        <item name="colorControlActivated">@color/dark_primary</item>
        <item name="colorControlHighlight">@color/dark_ripple</item>
        
        <!-- System bars -->
        <item name="android:statusBarColor">@color/dark_statusbar</item>
        <item name="android:navigationBarColor">@color/dark_navigationbar</item>
        
        <!-- Dividers -->
        <item name="android:listDivider">@color/dark_divider</item>
        <item name="dividerHorizontal">@color/dark_divider</item>
        <item name="dividerVertical">@color/dark_divider</item>
    </style>
    
    <!-- Dark Theme Dialpad Styles -->
    <style name="DialpadButtonStyle.Dark">
        <item name="android:background">@drawable/pill_background_dark</item>
        <item name="android:layout_marginStart">@dimen/small_margin</item>
        <item name="android:layout_marginEnd">@dimen/small_margin</item>
        <item name="android:paddingTop">@dimen/one_dp</item>
    </style>
    
    <style name="DialpadNumberStyle.Dark">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/dialpad_text_size</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/dark_dialpad_text</item>
    </style>
    
    <style name="DialpadLetterStyle.Dark">
        <item name="android:textSize">@dimen/dialpad_letters_text_size</item>
        <item name="android:alpha">0.8</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/dark_dialpad_text_secondary</item>
    </style>
    
    <!-- Dark Theme Button Style -->
    <style name="ButtonStyle.Dark">
        <item name="android:padding">@dimen/medium_margin</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:background">@drawable/button_background_dark</item>
    </style>
    
</resources>
