    <!-- Call Recording Consent (MANDATORY for Google Play) -->
    <string name="call_recording_consent_title">Call Recording Legal Notice</string>
    <string name="call_recording_consent_message">Call recording laws vary by jurisdiction and require informing the other party before recording. This app complies with these requirements by playing an audible beep tone when recording starts and stops.</string>
    <string name="call_recording_requirements_header">This app will:</string>
    <string name="recording_requirement_1">• Play a beep sound to the other party when recording starts</string>
    <string name="recording_requirement_2">• Play a beep sound when recording stops</string>
    <string name="recording_requirement_3">• Store recordings locally on your device</string>
    <string name="call_recording_legal_notice">By continuing, you consent to comply with all applicable call recording laws in your jurisdiction. You are responsible for ensuring legal compliance.</string>
