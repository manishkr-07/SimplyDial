<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_rounded_background">

    <!-- Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_video_call_vector"
        android:tint="?attr/colorPrimary" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Video Call in Progress"
        android:textColor="?android:textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/video_call_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="You have an ongoing video call"
        android:textColor="?android:textColorPrimary"
        android:textSize="14sp"
        android:alpha="0.8"
        android:layout_marginBottom="24dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Disconnect Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/disconnect_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Disconnect"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="@color/error_color"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_call_end"
            app:iconGravity="start"
            app:iconTint="?attr/colorOnPrimary" />

        <!-- Rejoin Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rejoin_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Rejoin"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_video_call_vector"
            app:iconGravity="start"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>
