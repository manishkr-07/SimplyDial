<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/activity_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Warning Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/medium_margin"
            android:contentDescription="@string/warning"
            android:src="@drawable/ic_warning_vector"
            android:tint="@color/md_orange" />

        <!-- Consent Title -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/medium_margin"
            android:gravity="center"
            android:text="@string/call_recording_consent_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Main consent text -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/medium_margin"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/call_recording_consent_message"
            android:textSize="15sp" />

        <!-- Key requirements -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/small_margin"
            android:text="@string/call_recording_requirements_header"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/medium_margin"
            android:orientation="vertical"
            android:paddingStart="@dimen/medium_margin"
            android:paddingEnd="0dp">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/small_margin"
                android:text="@string/recording_requirement_1"
                android:textSize="14sp" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/small_margin"
                android:text="@string/recording_requirement_2"
                android:textSize="14sp" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recording_requirement_3"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Legal notice -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:padding="@dimen/medium_margin"
            android:text="@string/call_recording_legal_notice"
            android:textColor="@color/error_color"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
