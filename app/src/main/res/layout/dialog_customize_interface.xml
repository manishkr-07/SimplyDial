            <TextView
                android:id="@+id/header_recents_messaging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/category_recents_messaging"
                android:textColor="@color/primary_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Feature 11: Floating Messages JoyStick -->
            <RelativeLayout
                android:id="@+id/holder_messages_joystick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/switch_messages_joystick"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/title_messages_joystick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/messages_joystick_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/desc_messages_joystick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
