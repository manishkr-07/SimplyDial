<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.3"
        android:background="@color/text_secondary" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/settings_icon_pill"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_message_vector"
            app:tint="@color/primary_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quick_decline_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_decline_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_decline_caller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/divider_color" />

    <!-- Quick Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Preset 1 -->
        <TextView
            android:id="@+id/quick_reply_preset_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="@string/quick_reply_1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Preset 2 -->
        <TextView
            android:id="@+id/quick_reply_preset_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="@string/quick_reply_2"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Preset 3 -->
        <TextView
            android:id="@+id/quick_reply_preset_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="@string/quick_reply_3"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Preset 4 (Hindi) -->
        <TextView
            android:id="@+id/quick_reply_preset_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="मैं अभी व्यस्त हूँ, थोड़ी देर में बात करता हूँ।"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Custom Message Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/quick_reply_custom_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/settings_chip_bg"
            android:hint="@string/quick_reply_custom"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/quick_reply_send_custom_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/contact_action_pill_primary_bg"
            android:clickable="true"
            android:contentDescription="@string/quick_reply"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_message_quick_reply"
            app:tint="@android:color/white" />

    </LinearLayout>

</LinearLayout>
