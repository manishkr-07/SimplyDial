<?xml version="1.0" encoding="utf-8"?>
<org.fossify.phone.fragments.RecentsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recents_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Filter Bar with horizontal scroll -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filter_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:checkable="true"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/filter_all"
                android:textSize="13sp"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_missed"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/filter_missed"
                android:textSize="13sp"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_incoming"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/filter_incoming"
                android:textSize="13sp"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_outgoing"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/filter_outgoing"
                android:textSize="13sp"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:ensureMinTouchTargetSize="false" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State Placeholder 1 -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/recents_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:text="@string/no_previous_calls"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Action Placeholder 2 (e.g. Permission request or action) -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/recents_placeholder_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/recents_placeholder"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/settings_header_banner_bg"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/request_access"
        android:textColor="@color/primary_color"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Today's Call Analytics Pill -->
    <LinearLayout
        android:id="@+id/recents_analytics_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/filter_scroll_view"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/settings_header_banner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_today_vector"
            app:tint="@color/primary_color" />

        <TextView
            android:id="@+id/recents_analytics_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Frequent Contacts Quick-Dial Carousel -->
    <HorizontalScrollView
        android:id="@+id/frequent_contacts_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/recents_analytics_card"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/frequent_contacts_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Recents RecyclerView -->
    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/recents_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/frequent_contacts_scroll_view"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        app:trackCornerRadius="@dimen/small_margin" />

</org.fossify.phone.fragments.RecentsFragment>
