<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/contact_item_glass_background"
    android:elevation="2dp"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.55"
    app:shimmer_highlight_alpha="0.95"
    app:shimmer_duration="1100">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Skeleton Avatar (48dp) -->
        <View
            android:id="@+id/skeleton_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_circle_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Skeleton Name -->
        <View
            android:id="@+id/skeleton_name"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/skeleton_bg"
            app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
            app:layout_constraintTop_toTopOf="@id/skeleton_avatar"
            app:layout_constraintEnd_toStartOf="@+id/skeleton_call_btn" />

        <!-- Skeleton Subtitle Line -->
        <View
            android:id="@+id/skeleton_line_small"
            android:layout_width="140dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/skeleton_bg"
            app:layout_constraintStart_toStartOf="@id/skeleton_name"
            app:layout_constraintTop_toBottomOf="@id/skeleton_name"/>

        <!-- Skeleton Call Button -->
        <View
            android:id="@+id/skeleton_call_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/skeleton_circle_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/skeleton_overflow"/>

        <!-- Skeleton Overflow Action Button -->
        <View
            android:id="@+id/skeleton_overflow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/skeleton_circle_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
