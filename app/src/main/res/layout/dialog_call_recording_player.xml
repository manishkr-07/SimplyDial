<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/settings_icon_pill"
                android:padding="5dp"
                android:src="@drawable/ic_mic_vector"
                app:tint="@color/primary_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_recording_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="CALL_IN_9876543210.m4a" />

                <TextView
                    android:id="@+id/player_recording_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:textSize="11sp"
                    tools:text="Oct 31, 2026 • 2.4 MB" />
            </LinearLayout>

            <!-- Playback Speed Button -->
            <TextView
                android:id="@+id/player_speed_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="1.0x"
                android:textColor="@color/primary_color"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar & Timers -->
        <SeekBar
            android:id="@+id/player_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:progressTint="@color/primary_color"
            android:thumbTint="@color/primary_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/player_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Share Button -->
            <ImageView
                android:id="@+id/player_share_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/settings_icon_pill"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_share_vector"
                app:tint="?attr/colorOnSurface" />

            <!-- Rewind 5s -->
            <ImageView
                android:id="@+id/player_rewind_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/settings_icon_pill"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_chevron_left_vector"
                app:tint="?attr/colorOnSurface" />

            <!-- Play / Pause Main FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/player_play_pause_fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:contentDescription="@string/play_recording"
                android:src="@drawable/ic_play_vector"
                app:backgroundTint="@color/primary_color"
                app:elevation="4dp"
                app:fabSize="normal"
                app:tint="@color/theme_dark_background_color" />

            <!-- Forward 5s -->
            <ImageView
                android:id="@+id/player_forward_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/settings_icon_pill"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_chevron_right_vector"
                app:tint="?attr/colorOnSurface" />

            <!-- Delete Button -->
            <ImageView
                android:id="@+id/player_delete_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/settings_icon_pill"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/error_color" />
        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
