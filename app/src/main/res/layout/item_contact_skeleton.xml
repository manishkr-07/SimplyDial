<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/contact_item_glass_background"
    android:elevation="2dp"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.55"
    app:shimmer_highlight_alpha="0.95"
    app:shimmer_duration="1100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/skeleton_circle"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name line ~55% width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="0.55"
                    android:background="@drawable/skeleton_rounded" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="0.45"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Number line ~35% width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="11dp"
                    android:layout_weight="0.35"
                    android:background="@drawable/skeleton_rounded" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="11dp"
                    android:layout_weight="0.65"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action pill placeholder -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/skeleton_circle" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
