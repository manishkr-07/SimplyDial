<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:paddingTop="@dimen/activity_margin"
    android:paddingBottom="@dimen/activity_margin">

    <!-- Handle bar -->
    <View
        android:id="@+id/bottom_sheet_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/medium_margin"
        android:background="@android:color/darker_gray"
        android:alpha="0.4"
        android:layout_marginTop="@dimen/small_margin" />

    <!-- Title -->
    <TextView
        android:id="@+id/language_selection_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_language"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/small_margin" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/language_selection_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_your_language"
        android:textSize="@dimen/normal_text_size"
        android:alpha="0.7"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/activity_margin" />

    <!-- English Option -->
    <LinearLayout
        android:id="@+id/language_option_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical">

        <!-- Radio button for English -->
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/radio_english"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <!-- English text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/medium_margin"
            android:paddingEnd="@dimen/medium_margin">

            <TextView
                android:id="@+id/language_english_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:textSize="@dimen/bigger_text_size" />

        </LinearLayout>

    </LinearLayout>

    <!-- Hindi Option -->
    <LinearLayout
        android:id="@+id/language_option_hindi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical">

        <!-- Radio button for Hindi -->
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/radio_hindi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <!-- Hindi text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/medium_margin"
            android:paddingEnd="@dimen/medium_margin">

            <TextView
                android:id="@+id/language_hindi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_hindi"
                android:textSize="@dimen/bigger_text_size" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
