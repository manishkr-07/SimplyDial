    <color name="card_background">#0A0A0A</color>
    <color name="dialog_background">#0D0D0D</color>
    
    <!-- Primary Accent - Electric Cyan/Aqua Neon -->
    <color name="primary_color">#00E5FF</color>
    <color name="primary_variant_color">#00B8D4</color>
    <color name="primary_dark_color">#00ACC1</color>
    
    <!-- Secondary Accent - Soft Aqua Highlight -->
    <color name="secondary_color">#4DD0E1</color>
