<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black Diamond Dark Theme - Auto-applied in system dark mode -->
    <!-- These colors override values/colors.xml when system dark mode is enabled -->
    
    <!-- Primary Backgrounds - AMOLED True Black -->
    <color name="background_color">#000000</color>
    <color name="surface_color">#0A0A0A</color>
    <color name="elevated_surface_color">#111111</color>
    
