<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Theme - Applied automatically in system dark mode -->
    
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_variant_color</item>
        <item name="colorOnPrimary">@color/fab_icon</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_color</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        
        <!-- Control colors -->
        <item name="colorControlNormal">@color/icon_secondary</item>
        <item name="colorControlActivated">@color/primary_color</item>
        <item name="colorControlHighlight">@color/ripple_color</item>
        
        <!-- System UI -->
        <item name="android:statusBarColor">@color/statusbar_color</item>
        <item name="android:navigationBarColor">@color/navigationbar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Other attributes -->
        <item name="android:listDivider">@color/divider_color</item>
        <item name="dividerHorizontal">@color/divider_color</item>
        <item name="dividerVertical">@color/divider_color</item>
        <item name="android:colorBackgroundFloating">@color/dialog_background</item>
        
        <!-- Modern 3-Dots Popup Menu Styling -->
        <item name="actionOverflowMenuStyle">@style/Widget.SimplyDial.PopupMenu.Overflow</item>
        <item name="popupMenuStyle">@style/Widget.SimplyDial.PopupMenu</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.SimplyDial.PopupMenu</item>
    </style>

    <style name="ThemeOverlay.SimplyDial.PopupMenu" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="android:colorBackground">@color/elevated_surface_color</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:popupBackground">@drawable/popup_menu_modern_bg</item>
        <item name="actionOverflowMenuStyle">@style/Widget.SimplyDial.PopupMenu.Overflow</item>
        <item name="popupMenuStyle">@style/Widget.SimplyDial.PopupMenu</item>
    </style>

    <style name="Widget.SimplyDial.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_modern_bg</item>
        
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="Widget.SimplyDial.PopupMenu.Overflow" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_menu_modern_bg</item>
        
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    
    <!-- Dark Theme Dialpad Buttons -->
    <style name="DialpadButtonStyle">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:layout_marginStart">@dimen/small_margin</item>
        <item name="android:layout_marginEnd">@dimen/small_margin</item>
        <item name="android:paddingTop">@dimen/one_dp</item>
    </style>

    <!-- Dark Theme Button Style -->
    <style name="ButtonStyle">
        <item name="android:padding">@dimen/medium_margin</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Dark Theme Dialpad Number Style -->
    <style name="DialpadNumberStyle">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/dialpad_text_size</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>

    <!-- Dark Theme Dialpad Letter Style -->
    <style name="DialpadLetterStyle">
        <item name="android:textSize">@dimen/dialpad_letters_text_size</item>
        <item name="android:alpha">0.8</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>
    
    <!-- Dark theme dialog style -->
    <style name="Theme.Fossify.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
    </style>

</resources>
