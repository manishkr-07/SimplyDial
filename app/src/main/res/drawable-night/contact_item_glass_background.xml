<?xml version="1.0" encoding="utf-8"?>
<!-- Black Diamond Theme - Elevated Card with Electric Cyan Border and Ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dark_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="#2600E5FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
