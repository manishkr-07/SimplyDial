<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border: White (left) to Golden (right) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#FFD700"
                android:angle="0"
                android:type="linear"/>
            <size
                android:width="48dp"
                android:height="48dp"/>
        </shape>
    </item>
    
    <!-- Background: White (left) to FFFFDD (right) -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#FFFFDD"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
