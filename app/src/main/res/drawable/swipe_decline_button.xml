<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Shadow layer -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#40000000"/>
        </shape>
    </item>
    
    <!-- Main red gradient background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF4444"
                android:centerColor="#FF0000"
                android:endColor="#CC0000"
                android:type="radial"
                android:gradientRadius="100dp"/>
        </shape>
    </item>
    
    <!-- Glossy overlay -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
        </shape>
    </item>
    
    <!-- Highlight -->
    <item
        android:top="6dp"
        android:left="6dp"
        android:right="40dp"
        android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="#60FFFFFF"/>
        </shape>
    </item>
    
</layer-list>
